# Copy this file to backend/.env (which git ignores) and fill in one AI's settings.
# Keys stay in the backend: the browser never sees them. Without a key the AI is off
# and the training runs on its ready-made scenarios.

# Which AI: claude or azure-openai. Leave it out to use whichever has a key (Claude first).
# AI_PROVIDER=claude

# --- Claude (Anthropic API, https://platform.claude.com) ---
ANTHROPIC_API_KEY=
# Any Claude model. Cheaper: claude-sonnet-5-5, or claude-haiku-5-5 (cheapest).
# AI_MODEL=claude-opus-5-5

# --- Azure OpenAI (Microsoft Foundry) ---
# The resource address, and a deployment of a model that supports structured outputs (for example gpt-5-mini).
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# AI requests per day.
# AI_DAILY_LIMIT=40
