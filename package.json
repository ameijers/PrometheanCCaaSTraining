  "devDependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "axe-core": "^4.14.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "puppeteer-core": "^25.16.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.2",
