{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "es2020"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@toolbox/*": ["vendor/toolbox/tools/*"] }
  },
  "include": ["src", "tests", "content", "backend/src", "vendor/toolbox/tools/**/*.d.ts"]
}
